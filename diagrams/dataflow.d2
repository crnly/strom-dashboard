vars: {d2-config: {theme-id: 101; sketch: true; pad: 24}}
# Der zeitliche Ablauf eines geplanten Imports.
shape: sequence_diagram
timer: Zeitplan
import: Python-Import
api: Energy-Charts
db: PostgreSQL
web: Python-Backend
browser: Browser
timer -> import: Import starten
import -> api: Preise für den gewünschten Tag anfordern
api -> import: JSON-Antwort mit Intervallen und Einheiten
import -> import: Antwort prüfen und in unser Datenformat überführen
import -> db: Werte anhand Markt und Intervall aktualisieren
db -> import: Speicherung bestätigen
import -> import: Ergebnis protokollieren und Prozess beenden
browser -> web: Dashboard öffnen
web -> browser: HTML, CSS und JavaScript
browser -> web: GET /api/prices über TypeScript
web -> db: Gespeicherte Tageswerte abfragen
db -> web: Preise und Datenstand
web -> browser: JSON mit Preisen und Datenstand
