vars: {d2-config: {theme-id: 101; sketch: true; pad: 24}}
# Geplanter Software- und Infrastrukturweg. Releases sind versioniert.
direction: down
repo: "GitHub-Repository\nTypeScript · Python · D2"
ci: "GitHub Actions · prüfen" {
  tests: "TypeScript-Build & API-Tests\nPython-Backend prüfen"
  docs: "D2 → SVG\nDokumentation erzeugen"
  plan: "terraform plan\nÄnderungen sichtbar machen"
}
image: "Docker-Image\nPython-Backend · feste Version"
registry: "GHCR\nContainer-Registry"
release: "Deployment auslösen\nAusgewählte Version"
server: "Cloud-Server" {
  init: "Terraform + cloud-init\nInfrastruktur & Grundeinrichtung"
  run: "Docker Compose\nImage starten · Daten erhalten"
  health: "Health-Check\nAntwortet die Anwendung?"
}
repo -> ci.tests: Anwendungscode
repo -> ci.docs: Diagrammquellen
repo -> ci.plan: Infrastrukturcode
ci.tests -> image: erfolgreich
ci.docs -> image: fertige SVGs
image -> registry: veröffentlichen
registry -> release: Version auswählen
release -> server.run: Image abrufen
ci.plan -> server.init: geprüften Plan anwenden
server.init -> server.run: Server bereit
server.run -> server.health: Start prüfen
