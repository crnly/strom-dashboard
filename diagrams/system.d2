vars: {d2-config: {theme-id: 101; sketch: true; pad: 24}}
# Geplanter Zielzustand. Noch keine laufende Infrastruktur.
direction: down
classes: {control: {style: {stroke-dash: 5}}}
browser: "Browser\nHTML · CSS · TypeScript"
source: "Energy-Charts\nExterne Datenquelle" {shape: cloud}
terraform: "Terraform\nServer · IP · Firewall"
server: "Hetzner Cloud · Ubuntu Linux · geplant" {
  containers: "Docker Compose" {
    caddy: "Caddy\nHTTPS & Weiterleitung"
    web: "Python-Backend\nWebsite & JSON-API"
    db: "PostgreSQL\nPreise & Datenstand" {shape: cylinder}
    import: "Import · geplant\nTemporärer Container"
  }
  timer: "systemd-Timer\nRegelmäßiger Start"
  disk: "Dauerhafter Speicher\nBleibt bei Containerwechsel" {shape: cylinder}
}
browser -> server.containers.caddy: HTTPS
server.containers.caddy -> server.containers.web: HTTP intern
server.containers.web -> server.containers.db: SQL lesen
server.timer -> server.containers.import: starten {class: control}
source -> server.containers.import: JSON-Daten
server.containers.import -> server.containers.db: SQL aktualisieren
server.containers.db -> server.disk: Daten speichern
terraform -> server: stellt Ressourcen bereit {class: control}
