vars: {d2-config: {theme-id: 101; sketch: true; pad: 24}}
# Vorschlag für unser eigenes Datenmodell, keine Energy-Charts-Antwort.
direction: right
normalized: "Geprüfter Preiswert\nEin Markt · ein Zeitintervall\nEinheit: EUR/MWh"
prices: Preise {
  shape: sql_table
  market: text {constraint: primary_key}
  interval_start: timestamptz {constraint: primary_key}
  interval_end: timestamptz
  price_eur_mwh: numeric
  imported_at: timestamptz
}
query: "Tagesabfrage\nMarkt + Zeitraum\nNach Intervall sortiert"
normalized -> prices: einfügen oder aktualisieren
prices -> query: SQL-Abfrage
